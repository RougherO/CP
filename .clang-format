# Layout: Google base, 4-space indent, 120 columns (the library's existing layout).
# Owner preferences: east const, aligned assignments/macros, includes never re-sorted.
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 120
AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true

# `#  include` inside `#if` blocks
IndentPPDirectives: AfterHash
PPIndentWidth: 2

# Modern syntax everywhere: `>>` closes nested templates (Auto guesses C++03 per file and writes `> >`).
Standard: Latest

QualifierAlignment: Right
DerivePointerAlignment: false
PointerAlignment: Left

AlignConsecutiveAssignments:
  Enabled: true
  AlignCompound: true
AlignConsecutiveMacros:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignEscapedNewlines: Left
AlignOperands: AlignAfterOperator
BreakBeforeTernaryOperators: true

AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortLambdasOnASingleLine: All
SpaceInEmptyBlock: true

SortIncludes: Never
IncludeBlocks: Preserve
