{
    // clangd is the C++ language server; it reads .clangd and build/compile_commands.json.
    "clangd.arguments": [
        "--enable-config",
        "--clang-tidy",
        "--compile-commands-dir=build",
        "--header-insertion=never",
        "--background-index",
        "--completion-style=detailed"
    ],
    "clangd.onConfigChanged": "restart",

    // clangd formats with .clang-format.
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "editor.rulers": [120],
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "*.hpp": "cpp"
    },

    // xmake replaced CMake; keep CMake Tools from configuring.
    "cmake.configureOnOpen": false,
    "cmake.automaticReconfigure": false,
    "cmake.ignoreCMakeListsMissing": true,

    // clang-tidy already runs inside clangd; the standalone extension uses the same database.
    "clang-tidy.buildPath": "build",

    "xmake.compileCommandsDirectory": "build",
    "xmake.debugConfigType": "codelldb",

    "lldb.displayFormat": "auto",
    "lldb.dereferencePointers": true,
    "lldb.consoleMode": "commands",

    "files.exclude": {
        "**/.xmake": true,
        "**/.cache": true
    },
    "search.exclude": {
        "build/**": true
    }
}
